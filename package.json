{
  "name": "volta-bet",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c green,cyan \"npm run dev -w apps/server\" \"npm run dev -w apps/web\"",
    "build": "npm run build -w apps/web",
    "start": "npm run start -w apps/server",
    "test": "npm test -w apps/server",
    "start:prod": "npm run start:prod -w apps/server"
  },
  "devDependencies": {
    "concurrently": "^9.2.5"
  }
}
