# Токен бота от @BotFather
BOT_TOKEN=
# Telegram ID админов через запятую
ADMIN_IDS=
# Публичный HTTPS-адрес Mini App (туннель или домен). Пусто — бот работает без кнопки
PUBLIC_URL=
PORT=3000
# Разрешить вход из обычного браузера без Telegram (только для разработки)
DEV_AUTH=true
# Ускорение лайва (во сколько раз матч идёт быстрее реального времени)
LIVE_SPEED=6
# Реальные матчи (бесплатный ключ: football-data.org → Register). Пусто — раздел выключен
FOOTBALL_DATA_KEY=
# Включить реальные деньги (не реализовано, должно быть false)
REAL_MONEY_ENABLED=false

# Прокси для доступа к Telegram API (пусто — без прокси / HTTPS_PROXY из системы)
TG_PROXY=

# Hugging Face (выкладка: bash scripts/deploy-hf.sh)
HF_USER=
HF_TOKEN=
HF_SPACE=volta
# адрес пересыльщика Telegram API, если хостинг не пускает к api.telegram.org
TG_API_ROOT=
